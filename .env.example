# Copy this file to `.env.local` (git-ignored) and fill in values. Never commit .env.local.
# The app itself needs NO secrets: the frontend reads its backend settings from
# amplify_outputs.json, which `npx ampx sandbox` generates (also git-ignored).

# AWS CLI profile and region used by `npx ampx sandbox --profile todo-dev`
# (set up with `aws configure sso`). Shown here for reference only.
AWS_PROFILE=todo-dev
AWS_REGION=ap-south-1

# Only for `npm run test:authz` and `npm run test:assistant-authz` (owner-only authorization
# tests against the SANDBOX).
# Two DIFFERENT accounts you created in the sandbox app (sign up + verify each first).
# Use sandbox-only test passwords — never reuse a real password here.
AUTHZ_USER_A_EMAIL=
AUTHZ_USER_A_PASSWORD=
AUTHZ_USER_B_EMAIL=
AUTHZ_USER_B_PASSWORD=
