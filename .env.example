# Copy this file to `.env.local` (git-ignored) if you need local overrides.
# This app does NOT need any secrets in .env: the frontend reads its backend
# settings from amplify_outputs.json, which `npx ampx sandbox` generates.

# AWS CLI profile used by `npx ampx sandbox` (set up with `aws configure sso`).
AWS_PROFILE=todo-dev
AWS_REGION=ap-south-1

# Only for `npm run test:authz` (two throwaway SANDBOX users, never real ones).
AUTHZ_TEST_PASSWORD=
